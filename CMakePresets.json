{
    "version": 6,

    "configurePresets": [
        {
            "name": "debug",
            "displayName": "zRTOS Debug",
            "description": "Build firmware zRTOS cho STM32F103C8T6 ở chế độ Debug.",

            "generator": "Ninja",

            "binaryDir": "${sourceDir}/build/debug",

            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-toolchain.cmake",

            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",

                "ZRTOS_BUILD_EXAMPLES": "ON",
                "ZRTOS_BUILD_TESTS": "ON",
                "ZRTOS_BUILD_HOST_TESTS": "OFF"
            }
        },

        {
            "name": "release",
            "displayName": "zRTOS Release",
            "description": "Build firmware zRTOS cho STM32F103C8T6 ở chế độ Release.",

            "generator": "Ninja",

            "binaryDir": "${sourceDir}/build/release",

            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-toolchain.cmake",

            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",

                "ZRTOS_BUILD_EXAMPLES": "ON",
                "ZRTOS_BUILD_TESTS": "OFF",
                "ZRTOS_BUILD_HOST_TESTS": "OFF"
            }
        },

        {
            "name": "host-test",
            "displayName": "zRTOS Host Tests",
            "description": "Build các test portable của zRTOS bằng compiler trên máy host.",

            "generator": "Ninja",

            "binaryDir": "${sourceDir}/build/host-test",

            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",

                "ZRTOS_BUILD_EXAMPLES": "OFF",
                "ZRTOS_BUILD_TESTS": "ON",
                "ZRTOS_BUILD_HOST_TESTS": "ON"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },

        {
            "name": "release",
            "configurePreset": "release"
        },

        {
            "name": "host-test",
            "configurePreset": "host-test"
        }
    ],

    "testPresets": [
        {
            "name": "host-test",
            "configurePreset": "host-test",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}